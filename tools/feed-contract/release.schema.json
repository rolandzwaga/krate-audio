{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krateaudio.com/schemas/release.schema.json",
  "title": "Krate Audio per-release manifest release.json (C2)",
  "$comment": "FR-015, FR-016, PD-10: closed objects at every level, no channel key (FR-018). Definitions are copied from versions.v2.schema.json so neither schema fetches the other. Cross-field rules (FR-017) are code in contract.js checkReleaseManifest. See CONTRACT.md.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "tag": { "$ref": "#/$defs/tagPre" },
    "name": { "$ref": "#/$defs/pluginName" },
    "version": { "$ref": "#/$defs/semver" },
    "pub_date": { "$ref": "#/$defs/pubDate" },
    "assets": {
      "$comment": "FR-016: windows-x86_64, linux-x86_64 and exactly one darwin-* key; the format is bound per key (PD-10).",
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "enum": ["windows-x86_64", "darwin-aarch64", "darwin-x86_64", "darwin-universal", "linux-x86_64"]
      },
      "minProperties": 3,
      "maxProperties": 3,
      "allOf": [
        {
          "$comment": "In its own subschema: Ajv strict mode rejects a properties key that a sibling patternProperties pattern matches.",
          "type": "object",
          "properties": { "windows-x86_64": true, "linux-x86_64": true },
          "required": ["windows-x86_64", "linux-x86_64"]
        }
      ],
      "patternProperties": {
        "^(windows|darwin|linux)-": { "$ref": "#/$defs/asset" },
        "^windows-": { "type": "object", "properties": { "format": { "const": "inno-exe" } } },
        "^darwin-": {
          "type": "object",
          "properties": { "format": { "const": "pkg" }, "min_os": true },
          "required": ["min_os"]
        },
        "^linux-": {
          "type": "object",
          "properties": { "format": { "const": "tar.gz" }, "min_os": true },
          "required": ["min_os"]
        }
      }
    },
    "install": { "$ref": "#/$defs/install" }
  },
  "required": ["tag", "name", "version", "pub_date", "assets", "install"],
  "$defs": {
    "semver": {
      "$comment": "FR-015: the bounded core (FR-004) with an optional SemVer 2.0.0 prerelease suffix, no build metadata.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?$"
    },
    "tagPre": {
      "type": "string",
      "pattern": "^[a-z0-9]+/v(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?$"
    },
    "pubDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "url": {
      "type": "string",
      "pattern": "^https://[^\\s]+$",
      "not": { "pattern": "/releases/latest/" }
    },
    "signature": {
      "type": "string",
      "pattern": "^untrusted comment: [^\\r\\n]*\\n[A-Za-z0-9+/=]+\\ntrusted comment: [^\\r\\n]+\\n[A-Za-z0-9+/=]+\\n$"
    },
    "reservedStem": {
      "type": "string",
      "pattern": "^([Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][0-9]|[Ll][Pp][Tt][0-9])(\\..*)?$"
    },
    "pluginName": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]{0,63}$",
      "not": { "$ref": "#/$defs/reservedStem" }
    },
    "installName": {
      "type": "string",
      "allOf": [{ "not": { "pattern": "\\.\\." } }, { "not": { "$ref": "#/$defs/reservedStem" } }]
    },
    "asset": {
      "$comment": "FR-016: the FR-006 platform rules plus the asset name; payload carries the C4 listing on tar.gz only.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "url": { "$ref": "#/$defs/url" },
        "size": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "signature": { "$ref": "#/$defs/signature" },
        "format": { "enum": ["inno-exe", "pkg", "tar.gz"] },
        "min_os": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+){1,3}$" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "files": { "type": "integer", "minimum": 1 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "list": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          },
          "required": ["files", "sha256", "list"]
        }
      },
      "required": ["name", "url", "size", "sha256", "signature", "format"],
      "if": { "type": "object", "properties": { "format": { "const": "tar.gz" } } },
      "then": { "type": "object", "properties": { "payload": true }, "required": ["payload"] },
      "else": { "type": "object", "properties": { "payload": false } }
    },
    "install": {
      "$comment": "FR-015 (as FR-008) + PD-10: the four install facts are always required in C2.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vst3_bundle": {
          "$ref": "#/$defs/installName",
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 _.-]*\\.vst3$"
        },
        "au_component": {
          "$ref": "#/$defs/installName",
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 _.-]*\\.component$"
        },
        "preset_subdir": {
          "$ref": "#/$defs/installName",
          "type": "string",
          "pattern": "^[A-Za-z0-9]([A-Za-z0-9 _-]*[A-Za-z0-9_-])?$"
        },
        "windows_uninstall_key": {
          "type": "string",
          "pattern": "^\\{[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}\\}_is1$",
          "not": { "pattern": "\\.\\." }
        },
        "macos_pkg_id": {
          "type": "string",
          "pattern": "^com\\.krateaudio\\.[a-z0-9]+$",
          "not": { "pattern": "\\.\\." }
        }
      },
      "required": ["vst3_bundle", "au_component", "windows_uninstall_key", "macos_pkg_id"]
    }
  }
}
