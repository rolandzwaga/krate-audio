<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
  <!-- Vorago editor (specs/vorago-phase13-ui, task T015; plan section 7).
       Generated by a Node.js script; fixed 1100 x 760 window, concept-first:
       header (0,0,1100,36), concept band (0,36,1100,436) with the twelve macro
       ArcKnobs around the EcosystemView, page strip (0,436,1100,464), page area
       (0,464,1100,760) holding seven SIBLING page containers (never a
       UIViewSwitchContainer), exactly one visible. 106 bound controls: every
       registered ID except the hidden performance controllers 4 and 5. The
       page strip and the preset button carry no parameter tag; the
       VoragoPanel sub-controller gives them session tags (9000 and up). -->
  <colors>
    <color name="bg" rgba="#101014ff"/>
    <color name="text" rgba="#D8D8E0ff"/>
    <color name="text-dim" rgba="#8C8C9Cff"/>
    <color name="track" rgba="#22222Aff"/>
    <color name="accent" rgba="#7A8CA8ff"/>
    <color name="eco-bg" rgba="#0A0A0Eff"/>
    <color name="eco-grid" rgba="#1C1C26ff"/>
    <color name="eco-link" rgba="#6E7F9C99"/>
    <color name="eco-partial" rgba="#C8B27Aff"/>
    <color name="eco-resonator" rgba="#7AA8C8ff"/>
    <color name="eco-noise" rgba="#9C8CB4ff"/>
    <color name="eco-feedback" rgba="#B4706Eff"/>
    <color name="eco-ghost" rgba="#A8B4BCff"/>
    <color name="macro-arc" rgba="#A89878ff"/>
  </colors>
  <fonts>
    <font name="label-font" font-name="Arial" size="11"/>
    <font name="macro-font" font-name="Arial" size="13"/>
    <font name="title-font" font-name="Arial" size="16"/>
  </fonts>
  <gradients>
    <gradient name="segment-off">
      <color-stop rgba="#1C1C24ff" start="0"/>
      <color-stop rgba="#15151Bff" start="1"/>
    </gradient>
    <gradient name="segment-on">
      <color-stop rgba="#343C4Cff" start="0"/>
      <color-stop rgba="#262C38ff" start="1"/>
    </gradient>
  </gradients>
  <control-tags>
    <control-tag name="MasterGain" tag="0"/>
    <control-tag name="Polyphony" tag="1"/>
    <control-tag name="MacroDarkness" tag="100"/>
    <control-tag name="MacroAge" tag="101"/>
    <control-tag name="MacroDensity" tag="102"/>
    <control-tag name="MacroMovement" tag="103"/>
    <control-tag name="MacroGravity" tag="104"/>
    <control-tag name="MacroEntropy" tag="105"/>
    <control-tag name="MacroPressure" tag="106"/>
    <control-tag name="MacroWeight" tag="107"/>
    <control-tag name="MacroFog" tag="108"/>
    <control-tag name="MacroLife" tag="109"/>
    <control-tag name="MacroDepth" tag="110"/>
    <control-tag name="MacroMass" tag="111"/>
    <control-tag name="Seed" tag="2"/>
    <control-tag name="OutputSaturation" tag="3"/>
    <control-tag name="CloudRichness" tag="200"/>
    <control-tag name="CloudTilt" tag="201"/>
    <control-tag name="CloudMutation" tag="202"/>
    <control-tag name="CloudInharmonicity" tag="203"/>
    <control-tag name="CloudDriftDepth" tag="204"/>
    <control-tag name="CloudStereoSpread" tag="205"/>
    <control-tag name="CloudSpectralGravity" tag="206"/>
    <control-tag name="NoiseLevel" tag="300"/>
    <control-tag name="NoiseWake" tag="301"/>
    <control-tag name="NoiseWanderRate" tag="302"/>
    <control-tag name="NoiseSlot0Model" tag="310"/>
    <control-tag name="NoiseSlot1Model" tag="311"/>
    <control-tag name="NoiseSlot2Model" tag="312"/>
    <control-tag name="NoiseSlot3Model" tag="313"/>
    <control-tag name="NoiseSlot0Type" tag="320"/>
    <control-tag name="NoiseSlot1Type" tag="321"/>
    <control-tag name="NoiseSlot2Type" tag="322"/>
    <control-tag name="NoiseSlot3Type" tag="323"/>
    <control-tag name="NoiseSlot0CombFundamental" tag="330"/>
    <control-tag name="NoiseSlot1CombFundamental" tag="331"/>
    <control-tag name="NoiseSlot2CombFundamental" tag="332"/>
    <control-tag name="NoiseSlot3CombFundamental" tag="333"/>
    <control-tag name="NoiseSlot0CombSpread" tag="340"/>
    <control-tag name="NoiseSlot1CombSpread" tag="341"/>
    <control-tag name="NoiseSlot2CombSpread" tag="342"/>
    <control-tag name="NoiseSlot3CombSpread" tag="343"/>
    <control-tag name="NoiseSlot0CombFeedback" tag="350"/>
    <control-tag name="NoiseSlot1CombFeedback" tag="351"/>
    <control-tag name="NoiseSlot2CombFeedback" tag="352"/>
    <control-tag name="NoiseSlot3CombFeedback" tag="353"/>
    <control-tag name="ResonanceGravity" tag="400"/>
    <control-tag name="ResonanceMix" tag="401"/>
    <control-tag name="ResonanceWanderRate" tag="402"/>
    <control-tag name="ResonanceAnchorMode" tag="403"/>
    <control-tag name="EcologyMix" tag="500"/>
    <control-tag name="EcologyLoopGain" tag="501"/>
    <control-tag name="EcologyLoop0FilterMode" tag="510"/>
    <control-tag name="EcologyLoop1FilterMode" tag="511"/>
    <control-tag name="EcologyLoop2FilterMode" tag="512"/>
    <control-tag name="EcologyLoop3FilterMode" tag="513"/>
    <control-tag name="EcologyLoop4FilterMode" tag="514"/>
    <control-tag name="EcologyLoop5FilterMode" tag="515"/>
    <control-tag name="SubLevelOffset" tag="600"/>
    <control-tag name="SubTracking" tag="601"/>
    <control-tag name="SubDiv2Level" tag="610"/>
    <control-tag name="SubDiv4Level" tag="611"/>
    <control-tag name="SubFifthBelowLevel" tag="612"/>
    <control-tag name="SmearAmount" tag="700"/>
    <control-tag name="SmearDecoherence" tag="701"/>
    <control-tag name="SmearTilt" tag="702"/>
    <control-tag name="EventsRateScale" tag="800"/>
    <control-tag name="EcosystemDepth" tag="900"/>
    <control-tag name="BodyBlend" tag="1000"/>
    <control-tag name="BodyDamping" tag="1001"/>
    <control-tag name="BodyResonance" tag="1002"/>
    <control-tag name="BodyMix" tag="1003"/>
    <control-tag name="BodyMaterialA" tag="1004"/>
    <control-tag name="BodyMaterialB" tag="1005"/>
    <control-tag name="SpaceSize" tag="1100"/>
    <control-tag name="SpaceDarkness" tag="1101"/>
    <control-tag name="SpaceDecay" tag="1102"/>
    <control-tag name="SpaceFog" tag="1103"/>
    <control-tag name="SpaceDamperDepth" tag="1104"/>
    <control-tag name="SpaceMix" tag="1105"/>
    <control-tag name="SpaceWidth" tag="1106"/>
    <control-tag name="SpaceDensity" tag="1107"/>
    <control-tag name="SpaceDimensionality" tag="1108"/>
    <control-tag name="SpaceBreath" tag="1109"/>
    <control-tag name="SpaceEarlySize" tag="1110"/>
    <control-tag name="SpaceEarlyLevel" tag="1111"/>
    <control-tag name="SpaceEarlyAbsorption" tag="1112"/>
    <control-tag name="SpaceEarlySend" tag="1113"/>
    <control-tag name="SpaceDamperRate" tag="1114"/>
    <control-tag name="SpaceFreeze" tag="1115"/>
    <control-tag name="EnvelopeMode" tag="1200"/>
    <control-tag name="EnvelopeStage0Time" tag="1201"/>
    <control-tag name="EnvelopeStage1Time" tag="1202"/>
    <control-tag name="EnvelopeStage2Time" tag="1203"/>
    <control-tag name="EnvelopeStage3Time" tag="1204"/>
    <control-tag name="EnvelopeRelease" tag="1205"/>
    <control-tag name="EnvelopeGrowthDuration" tag="1206"/>
    <control-tag name="BloomDepth" tag="1300"/>
    <control-tag name="BloomSpawnRate" tag="1301"/>
    <control-tag name="GhostPeakLevel" tag="1400"/>
    <control-tag name="GhostBlur" tag="1401"/>
    <control-tag name="GhostReverseProbability" tag="1402"/>
    <control-tag name="GhostEventTriggers" tag="1403"/>
    <control-tag name="LifeBreathingDepth" tag="1500"/>
    <control-tag name="LifeBreathingIrregularity" tag="1501"/>
    <control-tag name="LifeTidalDepth" tag="1502"/>
  </control-tags>
  <template name="editor" class="CViewContainer" size="1100, 760" minSize="1100, 760"
            maxSize="1100, 760" background-color="bg" transparent="false"
            sub-controller="VoragoPanel">
    <!-- HEADER (0, 0, 1100, 36): title, preset button, global controls 0-3 -->
    <view class="CViewContainer" uidesc-label="header" origin="0, 0" size="1100, 36" transparent="true">
      <view class="CTextLabel" title="VORAGO" origin="14, 8" size="100, 20" font="title-font" font-color="accent" transparent="true" text-alignment="left" mouse-enabled="false"/>
      <view class="CView" custom-view-name="PresetBrowserButton" origin="124, 7" size="90, 22"/>
      <view class="CTextLabel" title="Gain" origin="262, 11" size="36, 14" font="label-font" font-color="text-dim" transparent="true" text-alignment="right" mouse-enabled="false"/>
      <view class="CSlider" control-tag="MasterGain" origin="302, 10" size="120, 16" orientation="horizontal" draw-frame="true" draw-back="true" draw-value="true" frame-color="accent" back-color="track" value-color="accent" tooltip="Master output level of the whole instrument"/>
      <view class="CTextLabel" title="Voices" origin="440, 11" size="44, 14" font="label-font" font-color="text-dim" transparent="true" text-alignment="right" mouse-enabled="false"/>
      <view class="COptionMenu" control-tag="Polyphony" origin="488, 9" size="60, 18" font="label-font" font-color="text" frame-color="accent" back-color="track" fill-color="track" frame-width="1" transparent="false" style-3D-in="false" style-3D-out="false" tooltip="Maximum number of simultaneous voices, 1 to 6"/>
      <view class="CTextLabel" title="Seed" origin="566, 11" size="34, 14" font="label-font" font-color="text-dim" transparent="true" text-alignment="right" mouse-enabled="false"/>
      <view class="COptionMenu" control-tag="Seed" origin="604, 9" size="80, 18" font="label-font" font-color="text" frame-color="accent" back-color="track" fill-color="track" frame-width="1" transparent="false" style-3D-in="false" style-3D-out="false" tooltip="Random seed for every stochastic process; re-rolls the texture"/>
      <view class="CTextLabel" title="Saturation" origin="702, 11" size="70, 14" font="label-font" font-color="text-dim" transparent="true" text-alignment="right" mouse-enabled="false"/>
      <view class="CSlider" control-tag="OutputSaturation" origin="776, 10" size="120, 16" orientation="horizontal" draw-frame="true" draw-back="true" draw-value="true" frame-color="accent" back-color="track" value-color="accent" tooltip="Soft output saturation before the final limiter"/>
    </view>
    <!-- CONCEPT BAND (0, 36, 1100, 436): macros 100-105 | ecosystem | macros 106-111 -->
    <view class="CViewContainer" uidesc-label="concept-band" origin="0, 36" size="1100, 400" transparent="true">
      <view class="CViewContainer" uidesc-label="macros-left" origin="0, 0" size="350, 400" transparent="true">
        <view class="ArcKnob" control-tag="MacroDarkness" origin="40, 10" size="96, 96" arc-color="macro-arc" guide-color="track" tooltip="Darkens the cloud tilt, the smear and the cavern"/>
        <view class="CTextLabel" title="Darkness" origin="20, 110" size="135, 16" font="macro-font" font-color="text" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="MacroAge" origin="214, 10" size="96, 96" arc-color="macro-arc" guide-color="track" tooltip="Wear: duller cloud, more body damping, a shorter cavern decay"/>
        <view class="CTextLabel" title="Age" origin="195, 110" size="135, 16" font="macro-font" font-color="text" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="MacroDensity" origin="40, 143" size="96, 96" arc-color="macro-arc" guide-color="track" tooltip="Richer cloud, louder and more reactive noise, deeper bloom"/>
        <view class="CTextLabel" title="Density" origin="20, 243" size="135, 16" font="macro-font" font-color="text" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="MacroMovement" origin="214, 143" size="96, 96" arc-color="macro-arc" guide-color="track" tooltip="Drift, wander, breathing and damper motion"/>
        <view class="CTextLabel" title="Movement" origin="195, 243" size="135, 16" font="macro-font" font-color="text" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="MacroGravity" origin="40, 276" size="96, 96" arc-color="macro-arc" guide-color="track" tooltip="Gravity: pulls the resonances toward the harmonic grid"/>
        <view class="CTextLabel" title="Gravity" origin="20, 376" size="135, 16" font="macro-font" font-color="text" transparent="true" text-alignment="center" mouse-enabled="false" uidesc-label="macro-gravity-label"/>
        <view class="ArcKnob" control-tag="MacroEntropy" origin="214, 276" size="96, 96" arc-color="macro-arc" guide-color="track" tooltip="Mutation, inharmonicity, decoherence and irregular breathing"/>
        <view class="CTextLabel" title="Entropy" origin="195, 376" size="135, 16" font="macro-font" font-color="text" transparent="true" text-alignment="center" mouse-enabled="false"/>
      </view>
      <view class="CView" custom-view-name="EcosystemView" uidesc-label="ecosystem" origin="350, 0" size="400, 400"/>
      <view class="CViewContainer" uidesc-label="macros-right" origin="750, 0" size="350, 400" transparent="true">
        <view class="ArcKnob" control-tag="MacroPressure" origin="40, 10" size="96, 96" arc-color="macro-arc" guide-color="track" tooltip="Ecology feedback, output drive and saturation"/>
        <view class="CTextLabel" title="Pressure" origin="20, 110" size="135, 16" font="macro-font" font-color="text" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="MacroWeight" origin="214, 10" size="96, 96" arc-color="macro-arc" guide-color="track" tooltip="Sub level, body blend and damping, a heavier spectral tilt"/>
        <view class="CTextLabel" title="Weight" origin="195, 110" size="135, 16" font="macro-font" font-color="text" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="MacroFog" origin="40, 143" size="96, 96" arc-color="macro-arc" guide-color="track" tooltip="Smear, ghosts, blur, tides and a foggier, darker cavern"/>
        <view class="CTextLabel" title="Fog" origin="20, 243" size="135, 16" font="macro-font" font-color="text" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="MacroLife" origin="214, 143" size="96, 96" arc-color="macro-arc" guide-color="track" tooltip="Ecosystem depth, event rate and bloom spawning"/>
        <view class="CTextLabel" title="Life" origin="195, 243" size="135, 16" font="macro-font" font-color="text" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="MacroDepth" origin="40, 276" size="96, 96" arc-color="macro-arc" guide-color="track" tooltip="Cavern mix, size, decay and width"/>
        <view class="CTextLabel" title="Depth" origin="20, 376" size="135, 16" font="macro-font" font-color="text" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="MacroMass" origin="214, 276" size="96, 96" arc-color="macro-arc" guide-color="track" tooltip="Body and resonator level, body resonance and sub tracking"/>
        <view class="CTextLabel" title="Mass" origin="195, 376" size="135, 16" font="macro-font" font-color="text" transparent="true" text-alignment="center" mouse-enabled="false"/>
      </view>
    </view>
    <!-- PAGE STRIP (0, 436, 1100, 464): session state only, no control-tag -->
    <view class="CSegmentButton" uidesc-label="page-strip" session-tag="pages" origin="0, 436" size="1100, 28" style="horizontal" selection-mode="Single" segment-names="Cloud,Noise,Resonance,Body,Sub / Smear,Space,Life" font="label-font" text-color="text-dim" text-color-highlighted="text" frame-color="track" frame-width="1" round-radius="0" gradient="segment-off" gradient-highlighted="segment-on" tooltip="Engine page shown below the concept band"/>
    <!-- PAGE AREA (0, 464, 1100, 760): seven sibling pages, 68 x 74 cell grid -->
    <view class="CViewContainer" uidesc-label="page-area" origin="0, 464" size="1100, 296" transparent="true">
      <!-- page-0: Cloud -->
      <view class="CViewContainer" uidesc-label="page-0" origin="0, 0" size="1100, 296" transparent="true">
        <view class="ArcKnob" control-tag="CloudRichness" origin="18, 4" size="44, 44" arc-color="accent" guide-color="track" tooltip="Number of active partials and how fast they roll off"/>
        <view class="CTextLabel" title="Richness" origin="6, 52" size="68, 14" font="label-font" font-color="text-dim" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="CloudTilt" origin="86, 4" size="44, 44" arc-color="accent" guide-color="track" tooltip="Spectral slope in dB per octave: dark below zero, bright above"/>
        <view class="CTextLabel" title="Tilt" origin="74, 52" size="68, 14" font="label-font" font-color="text-dim" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="CloudMutation" origin="154, 4" size="44, 44" arc-color="accent" guide-color="track" tooltip="How quickly the partial amplitudes slowly mutate"/>
        <view class="CTextLabel" title="Mutation" origin="142, 52" size="68, 14" font="label-font" font-color="text-dim" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="CloudInharmonicity" origin="222, 4" size="44, 44" arc-color="accent" guide-color="track" tooltip="Stretches partials off the harmonic grid, toward bell and metal"/>
        <view class="CTextLabel" title="Inharm" origin="210, 52" size="68, 14" font="label-font" font-color="text-dim" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="CloudDriftDepth" origin="290, 4" size="44, 44" arc-color="accent" guide-color="track" tooltip="Depth of the slow per-partial pitch drift, in cents"/>
        <view class="CTextLabel" title="Drift" origin="278, 52" size="68, 14" font="label-font" font-color="text-dim" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="CloudStereoSpread" origin="358, 4" size="44, 44" arc-color="accent" guide-color="track" tooltip="Stereo spread of the partial cloud"/>
        <view class="CTextLabel" title="Spread" origin="346, 52" size="68, 14" font="label-font" font-color="text-dim" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="CloudSpectralGravity" origin="426, 4" size="44, 44" arc-color="accent" guide-color="track" tooltip="Pulls partial energy toward the low (negative) or high (positive) end"/>
        <view class="CTextLabel" title="Spec Grav" origin="414, 52" size="68, 14" font="label-font" font-color="text-dim" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="BloomDepth" origin="18, 78" size="44, 44" arc-color="accent" guide-color="track" tooltip="Depth of the bloom partials"/>
        <view class="CTextLabel" title="Bloom" origin="6, 126" size="68, 14" font="label-font" font-color="text-dim" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="BloomSpawnRate" origin="86, 78" size="44, 44" arc-color="accent" guide-color="track" tooltip="How often new bloom partials spawn"/>
        <view class="CTextLabel" title="Bloom Rate" origin="74, 126" size="68, 14" font="label-font" font-color="text-dim" transparent="true" text-alignment="center" mouse-enabled="false"/>
      </view>
      <!-- page-1: Noise -->
      <view class="CViewContainer" uidesc-label="page-1" origin="0, 0" size="1100, 296" transparent="true">
        <view class="ArcKnob" control-tag="NoiseLevel" origin="18, 4" size="44, 44" arc-color="accent" guide-color="track" tooltip="Level of the noise layer"/>
        <view class="CTextLabel" title="Noise Lvl" origin="6, 52" size="68, 14" font="label-font" font-color="text-dim" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="NoiseWake" origin="86, 4" size="44, 44" arc-color="accent" guide-color="track" tooltip="How strongly the noise follows the energy of the drone"/>
        <view class="CTextLabel" title="Wake" origin="74, 52" size="68, 14" font="label-font" font-color="text-dim" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="NoiseWanderRate" origin="154, 4" size="44, 44" arc-color="accent" guide-color="track" tooltip="Rate of the slow wandering of the noise colour"/>
        <view class="CTextLabel" title="Wander" origin="142, 52" size="68, 14" font="label-font" font-color="text-dim" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="CTextLabel" title="Slot 1 Model" origin="6, 88" size="96, 14" font="label-font" font-color="text-dim" transparent="true" text-alignment="left" mouse-enabled="false"/>
        <view class="COptionMenu" control-tag="NoiseSlot0Model" origin="6, 104" size="96, 18" font="label-font" font-color="text" frame-color="accent" back-color="track" fill-color="track" frame-width="1" transparent="false" style-3D-in="false" style-3D-out="false" tooltip="Noise slot 1 model: Direct, Filtered Wind, Granular Dust or Metallic Hiss"/>
        <view class="CTextLabel" title="Slot 1 Type" origin="108, 88" size="96, 14" font="label-font" font-color="text-dim" transparent="true" text-alignment="left" mouse-enabled="false"/>
        <view class="COptionMenu" control-tag="NoiseSlot0Type" origin="108, 104" size="96, 18" font="label-font" font-color="text" frame-color="accent" back-color="track" fill-color="track" frame-width="1" transparent="false" style-3D-in="false" style-3D-out="false" tooltip="Noise slot 1 colour type"/>
        <view class="ArcKnob" control-tag="NoiseSlot0CombFundamental" origin="18, 152" size="44, 44" arc-color="accent" guide-color="track" tooltip="Noise slot 1 comb fundamental, in Hz"/>
        <view class="CTextLabel" title="S1 Freq" origin="6, 200" size="68, 14" font="label-font" font-color="text-dim" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="NoiseSlot0CombSpread" origin="86, 152" size="44, 44" arc-color="accent" guide-color="track" tooltip="Noise slot 1 comb tooth spread"/>
        <view class="CTextLabel" title="S1 Spread" origin="74, 200" size="68, 14" font="label-font" font-color="text-dim" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="NoiseSlot0CombFeedback" origin="154, 152" size="44, 44" arc-color="accent" guide-color="track" tooltip="Noise slot 1 comb feedback"/>
        <view class="CTextLabel" title="S1 Fdbk" origin="142, 200" size="68, 14" font="label-font" font-color="text-dim" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="CTextLabel" title="Slot 2 Model" origin="278, 88" size="96, 14" font="label-font" font-color="text-dim" transparent="true" text-alignment="left" mouse-enabled="false"/>
        <view class="COptionMenu" control-tag="NoiseSlot1Model" origin="278, 104" size="96, 18" font="label-font" font-color="text" frame-color="accent" back-color="track" fill-color="track" frame-width="1" transparent="false" style-3D-in="false" style-3D-out="false" tooltip="Noise slot 2 model: Direct, Filtered Wind, Granular Dust or Metallic Hiss"/>
        <view class="CTextLabel" title="Slot 2 Type" origin="380, 88" size="96, 14" font="label-font" font-color="text-dim" transparent="true" text-alignment="left" mouse-enabled="false"/>
        <view class="COptionMenu" control-tag="NoiseSlot1Type" origin="380, 104" size="96, 18" font="label-font" font-color="text" frame-color="accent" back-color="track" fill-color="track" frame-width="1" transparent="false" style-3D-in="false" style-3D-out="false" tooltip="Noise slot 2 colour type"/>
        <view class="ArcKnob" control-tag="NoiseSlot1CombFundamental" origin="290, 152" size="44, 44" arc-color="accent" guide-color="track" tooltip="Noise slot 2 comb fundamental, in Hz"/>
        <view class="CTextLabel" title="S2 Freq" origin="278, 200" size="68, 14" font="label-font" font-color="text-dim" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="NoiseSlot1CombSpread" origin="358, 152" size="44, 44" arc-color="accent" guide-color="track" tooltip="Noise slot 2 comb tooth spread"/>
        <view class="CTextLabel" title="S2 Spread" origin="346, 200" size="68, 14" font="label-font" font-color="text-dim" transparent="true" text-alignment="center" mouse-enabled="false"/>
