<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
  <!-- Profundum editor, Phase 12 (specs/profundum-phase12-ui; task T027; plan section 4.12).
       Fixed 960 x 600 (minSize = maxSize, D7); zoom 100 / 125 / 150 / 200 % through the UI-only
       zoom segments (session tag 9300, header and SETTINGS, ruled 2026-10-23).
       header (0, 0, 960, 56) | page-main and page-advanced: SIBLING containers (0, 56, 960, 544),
       never a UIViewSwitchContainer; exactly one is visible (ProfundumPanel, session tag 9100).
       Main (D1): mass-group, morph-anchor = anchor-group + morph-band. Advanced (D2): tab strip
       (session tag 9110) and three sibling tabs; one section container per FR-004 row.
       80 visible IDs bound; the hidden performance IDs 4 - 7 have no tag. UI-only controls carry
       session-tag (9000 and up) and no control-tag. Tooltips are the D1 / D2 literals.
       Later edits touching more than 3 controls use XSLT (repo rule). -->
  <colors>
    <color name="bg" rgba="#101014ff"/>
    <color name="panel" rgba="#1A1A20ff"/>
    <color name="track" rgba="#22222Aff"/>
    <color name="text" rgba="#D8D8E0ff"/>
    <color name="text-dim" rgba="#9A9AA8ff"/>
    <color name="accent" rgba="#7A8CA8ff"/>
    <color name="highlight" rgba="#E0B060ff"/>
    <color name="anchor" rgba="#D08A5Cff"/>
    <color name="mass" rgba="#7FB0D8ff"/>
  </colors>
  <fonts>
    <font name="small-font" font-name="Arial" size="10"/>
    <font name="label-font" font-name="Arial" size="11"/>
    <font name="section-font" font-name="Arial" size="11" bold="true"/>
    <font name="title-font" font-name="Arial" size="16" bold="true"/>
  </fonts>
  <gradients>
    <gradient name="segment-off">
      <color-stop rgba="#22222Aff" start="0"/>
      <color-stop rgba="#22222Aff" start="1"/>
    </gradient>
    <gradient name="segment-on">
      <color-stop rgba="#7A8CA8ff" start="0"/>
      <color-stop rgba="#7A8CA8ff" start="1"/>
    </gradient>
  </gradients>
  <control-tags>
    <control-tag name="OutputGain" tag="0"/>
    <control-tag name="VoiceMode" tag="1"/>
    <control-tag name="Polyphony" tag="2"/>
    <control-tag name="OutputCeiling" tag="3"/>
    <control-tag name="MacroWeight" tag="100"/>
    <control-tag name="MacroDarkBright" tag="101"/>
    <control-tag name="MacroTightLoose" tag="102"/>
    <control-tag name="MacroCleanViolent" tag="103"/>
    <control-tag name="Mass" tag="104"/>
    <control-tag name="MorphPosition" tag="105"/>
    <control-tag name="CoreDepth" tag="200"/>
    <control-tag name="CoreBody" tag="201"/>
    <control-tag name="CoreBodyCurvature" tag="202"/>
    <control-tag name="CoreBodyEmphasis" tag="203"/>
    <control-tag name="CoreEdge" tag="204"/>
    <control-tag name="CoreShift" tag="205"/>
    <control-tag name="CoreExcitationMix" tag="206"/>
    <control-tag name="CoreExcitationDrive" tag="207"/>
    <control-tag name="CoreExcitationAsymmetry" tag="208"/>
    <control-tag name="AnchorWaveform" tag="300"/>
    <control-tag name="AnchorMode" tag="301"/>
    <control-tag name="AnchorLevel" tag="302"/>
    <control-tag name="AnchorPunchBoost" tag="303"/>
    <control-tag name="AnchorPunchTime" tag="304"/>
    <control-tag name="AnchorGhostTime" tag="305"/>
    <control-tag name="AnchorFoldFeed" tag="306"/>
    <control-tag name="DropAmount" tag="400"/>
    <control-tag name="DropTime" tag="401"/>
    <control-tag name="DropShape" tag="402"/>
    <control-tag name="DropRebound" tag="403"/>
    <control-tag name="NoteMonoPriority" tag="410"/>
    <control-tag name="NoteLegato" tag="411"/>
    <control-tag name="NotePortamento" tag="412"/>
    <control-tag name="NotePortamentoMode" tag="413"/>
    <control-tag name="NoteGlideMode" tag="414"/>
    <control-tag name="NoteMemory" tag="415"/>
    <control-tag name="NoteRetrigger" tag="416"/>
    <control-tag name="NotePitchBendRange" tag="417"/>
    <control-tag name="AmpAttack" tag="420"/>
    <control-tag name="AmpDecay" tag="421"/>
    <control-tag name="AmpSustain" tag="422"/>
    <control-tag name="AmpRelease" tag="423"/>
    <control-tag name="AmpAttackCurve" tag="424"/>
    <control-tag name="AmpDecayCurve" tag="425"/>
    <control-tag name="AmpReleaseCurve" tag="426"/>
    <control-tag name="FoldAmount" tag="500"/>
    <control-tag name="FoldShape" tag="501"/>
    <control-tag name="Character" tag="600"/>
    <control-tag name="CharacterAmount" tag="601"/>
    <control-tag name="CharacterTone" tag="602"/>
    <control-tag name="DynamicsTransientAttack" tag="700"/>
    <control-tag name="DynamicsTransientSustain" tag="701"/>
    <control-tag name="FieldImageMode" tag="800"/>
    <control-tag name="FieldSpread" tag="801"/>
    <control-tag name="FieldGravity" tag="802"/>
    <control-tag name="FieldCrossover" tag="803"/>
    <control-tag name="FieldCurve" tag="804"/>
    <control-tag name="FieldMotionDepth" tag="805"/>
    <control-tag name="FieldMotionRate" tag="806"/>
    <control-tag name="FieldMotionSource" tag="807"/>
    <control-tag name="FieldSync" tag="808"/>
    <control-tag name="FieldSyncRate" tag="809"/>
    <control-tag name="MotionSource" tag="900"/>
    <control-tag name="MotionTarget" tag="901"/>
    <control-tag name="MotionAmount" tag="902"/>
    <control-tag name="MotionDepth" tag="903"/>
    <control-tag name="MotionCycleRate" tag="904"/>
    <control-tag name="MotionCycleShape" tag="905"/>
    <control-tag name="MotionCycleSync" tag="906"/>
    <control-tag name="MotionCycleSyncRate" tag="907"/>
    <control-tag name="MotionCyclePhase" tag="908"/>
    <control-tag name="MotionCycleRetrigger" tag="909"/>
    <control-tag name="MotionCycleFadeIn" tag="910"/>
    <control-tag name="MotionPolarity" tag="911"/>
    <control-tag name="MotionDriftSmoothness" tag="912"/>
    <control-tag name="MotionEnvAttack" tag="913"/>
    <control-tag name="MotionEnvDecay" tag="914"/>
    <control-tag name="MorphAnchorMode" tag="1000"/>
    <control-tag name="MorphEditTarget" tag="1001"/>
    <control-tag name="MorphRampTime" tag="1002"/>
  </control-tags>
  <template name="editor" class="CViewContainer" origin="0, 0" size="960, 600" minSize="960, 600" maxSize="960, 600"
            background-color="bg" background-color-draw-style="filled" transparent="false" sub-controller="ProfundumPanel">
    <view class="CViewContainer" uidesc-label="header" origin="0, 0" size="960, 56" background-color="bg" background-color-draw-style="filled" transparent="false">
      <view class="CTextLabel" title="PROFUNDUM" origin="16, 16" size="140, 24" font="title-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
      <view class="CTextLabel" title="VOICE" origin="170, 4" size="120, 16" font="small-font" font-color="text-dim" transparent="true" text-alignment="left" mouse-enabled="false"/>
      <view class="CSegmentButton" control-tag="VoiceMode" origin="170, 24" size="120, 24" style="horizontal" selection-mode="Single" font="small-font" text-color="text" text-color-highlighted="bg" frame-color="track" frame-width="1" round-radius="0" gradient="segment-off" gradient-highlighted="segment-on" tooltip="Mono plays one note at a time, with glide and legato. Poly plays chords; the voice count is on the Advanced page."/>
      <view class="CTextLabel" title="GLIDE" origin="310, 4" size="126, 16" font="small-font" font-color="text-dim" transparent="true" text-alignment="left" mouse-enabled="false"/>
      <view class="ArcKnob" control-tag="NotePortamento" origin="310, 22" size="30, 30" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Glide: time to slide between notes in Mono. The readout unit follows Glide Mode on the Advanced page."/>
      <view class="CParamDisplay" control-tag="NotePortamento" origin="346, 26" size="90, 20" font="label-font" font-color="text" transparent="true" text-alignment="right" tooltip="Glide: time to slide between notes in Mono. The readout unit follows Glide Mode on the Advanced page."/>
      <view class="CSegmentButton" uidesc-label="page-strip" session-tag="9100" origin="560, 24" size="200, 24" style="horizontal" selection-mode="Single" font="small-font" text-color="text" text-color-highlighted="bg" frame-color="track" frame-width="1" round-radius="0" gradient="segment-off" gradient-highlighted="segment-on" segment-names="MAIN,ADVANCED" tooltip="Switch between the Main and Advanced pages."/>
      <view class="CTextLabel" title="ZOOM" origin="780, 4" size="168, 16" font="small-font" font-color="text-dim" transparent="true" text-alignment="left" mouse-enabled="false"/>
      <view class="CSegmentButton" uidesc-label="zoom-header" session-tag="9300" origin="780, 24" size="168, 24" style="horizontal" selection-mode="Single" font="small-font" text-color="text" text-color-highlighted="bg" frame-color="track" frame-width="1" round-radius="0" gradient="segment-off" gradient-highlighted="segment-on" segment-names="100%,125%,150%,200%" tooltip="Editor zoom: 100, 125, 150 or 200 %. Kept for the session, not saved with the project."/>
      <view class="CView" custom-view-name="PresetBrowserButton" origin="452, 24" size="96, 24" tooltip="Browse and load factory and user presets."/>
    </view>
    <view class="CViewContainer" uidesc-label="page-main" origin="0, 56" size="960, 544" background-color="bg" background-color-draw-style="filled" transparent="false">
      <view class="CViewContainer" uidesc-label="mass-group" origin="8, 8" size="944, 316" background-color="panel" background-color-draw-style="filled" transparent="false">
        <view class="CTextLabel" title="THE MASS" origin="8, 4" size="200, 16" font="section-font" font-color="mass" transparent="true" text-alignment="left" mouse-enabled="false"/>
        <view class="CView" custom-view-name="HarmonicBarView" uidesc-label="bars-main" bar-variant="main" origin="8, 24" size="600, 180" tooltip="Measured harmonics of the sound you hear, with the anchor in its own lane."/>
        <view class="CTextLabel" title="DEPTH" origin="8, 214" size="96, 16" font="small-font" font-color="text" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="OffsetRingKnob" control-tag="CoreDepth" origin="36, 232" size="40, 40" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Depth: high keeps the energy in the fundamental; low spreads it up through the harmonics."/>
        <view class="CTextLabel" title="BODY" origin="108, 214" size="96, 16" font="small-font" font-color="text" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="OffsetRingKnob" control-tag="CoreBody" origin="136, 232" size="40, 40" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Body: the weight of the low harmonics that make the note sound full."/>
        <view class="CTextLabel" title="EDGE" origin="208, 214" size="96, 16" font="small-font" font-color="text" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="OffsetRingKnob" control-tag="CoreEdge" origin="236, 232" size="40, 40" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Edge: the bite of the upper harmonics. Turn it up for buzz and presence, down for a smooth, round bass."/>
        <view class="CTextLabel" title="FOLD" origin="308, 214" size="96, 16" font="small-font" font-color="text" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="OffsetRingKnob" control-tag="FoldAmount" origin="336, 232" size="40, 40" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Harmonic Fold: grows new harmonics, from soft saturation through harmonic compression to folding at 100. 0 is clean; the anchor stays clean unless Anchor Fold Feed sends it in."/>
        <view class="CTextLabel" title="MASS" origin="408, 214" size="96, 16" font="small-font" font-color="text" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="Mass" origin="436, 232" size="40, 40" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Mass: how heavy the note feels, from a pure, sine-like sub at 0 to an enormous driven bass at 100. 50 is neutral; the mod wheel and channel pressure push it higher."/>
        <view class="CTextLabel" title="DROP" origin="508, 214" size="96, 16" font="small-font" font-color="text" transparent="true" text-alignment="center" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="DropAmount" origin="536, 232" size="40, 40" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Drop: each note starts this many semitones above its pitch and falls onto it (0 to 48). 0 is off; its time and shape are on the Advanced page."/>
        <view class="CTextLabel" title="MACROS" origin="640, 4" size="200, 16" font="section-font" font-color="accent" transparent="true" text-alignment="left" mouse-enabled="false"/>
        <view class="CTextLabel" title="WEIGHT" origin="640, 28" size="120, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="MacroWeight" origin="640, 46" size="40, 40" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Weight: more depth, more body and a louder anchor together. Centre is neutral."/>
        <view class="CTextLabel" title="DARK ↔ BRIGHT" origin="640, 96" size="280, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
        <view class="BipolarSlider" control-tag="MacroDarkBright" origin="640, 114" size="280, 24" fill-color="accent" track-color="track" center-tick-color="text-dim" tooltip="Dark ↔ Bright: moves the edge, the spectral shift and the character tone together. Centre is neutral."/>
        <view class="CTextLabel" title="CLEAN ↔ VIOLENT" origin="640, 146" size="280, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
        <view class="BipolarSlider" control-tag="MacroCleanViolent" origin="640, 164" size="280, 24" fill-color="accent" track-color="track" center-tick-color="text-dim" tooltip="Clean ↔ Violent: more drive, more fold and more character together. Centre is neutral."/>
        <view class="CTextLabel" title="MOTION" origin="640, 198" size="280, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
        <view class="CSegmentButton" control-tag="MotionSource" origin="640, 216" size="280, 24" style="horizontal" selection-mode="Single" font="small-font" text-color="text" text-color-highlighted="bg" frame-color="track" frame-width="1" round-radius="0" gradient="segment-off" gradient-highlighted="segment-on" tooltip="Motion: what moves the sound over time. Its target, amount and timing are on the Advanced page."/>
      </view>
      <view class="CViewContainer" uidesc-label="morph-anchor" origin="8, 332" size="944, 204" background-color="bg" background-color-draw-style="filled" transparent="false">
        <view class="CViewContainer" uidesc-label="anchor-group" origin="0, 0" size="300, 204" background-color="panel" background-color-draw-style="filled" transparent="false">
          <view class="CTextLabel" title="THE ANCHOR" origin="8, 4" size="200, 16" font="section-font" font-color="anchor" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="CTextLabel" title="LEVEL" origin="8, 28" size="80, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="OffsetRingKnob" control-tag="AnchorLevel" origin="8, 46" size="40, 40" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Anchor Level: how loud the stable sub tone under the mass is. It stays centred and clean whatever the mass does."/>
          <view class="CTextLabel" title="CHARACTER" origin="100, 28" size="180, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="COptionMenu" control-tag="AnchorWaveform" origin="100, 50" size="180, 20" font="small-font" font-color="text" frame-color="accent" back-color="track" frame-width="1" transparent="false" style-3D-in="false" style-3D-out="false" tooltip="Anchor Waveform: the shape of the sub tone under the mass: Sine, Triangle, Rounded Sine, Asymmetric Sine or Octave Down."/>
          <view class="CTextLabel" title="MORPH BEHAVIOUR" origin="8, 120" size="200, 16" font="label-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="CSegmentButton" control-tag="MorphAnchorMode" origin="8, 140" size="270, 24" style="horizontal" selection-mode="Single" font="small-font" text-color="text" text-color-highlighted="bg" frame-color="track" frame-width="1" round-radius="0" gradient="segment-off" gradient-highlighted="segment-on" tooltip="Morph Behaviour: how the anchor follows the Bass Morph. Hold keeps A's anchor, Blend follows the morph, Yield hands over late."/>
        </view>
        <view class="CViewContainer" uidesc-label="morph-band" origin="308, 0" size="636, 204" background-color="panel" background-color-draw-style="filled" transparent="false">
          <view class="CTextLabel" title="BASS MORPH" origin="8, 4" size="200, 16" font="section-font" font-color="accent" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="CTextEdit" session-tag="9210" title="A" origin="8, 24" size="200, 20" font="label-font" font-color="text" back-color="track" frame-color="accent" frame-width="1" transparent="false" text-alignment="left" style-3D-in="false" style-3D-out="false" tooltip="Name of endpoint A. Saved with the preset."/>
          <view class="CTextEdit" session-tag="9211" title="B" origin="428, 24" size="200, 20" font="label-font" font-color="text" back-color="track" frame-color="accent" frame-width="1" transparent="false" text-alignment="left" style-3D-in="false" style-3D-out="false" tooltip="Name of endpoint B. Saved with the preset."/>
          <view class="CTextLabel" session-tag="9220" title="" origin="8, 46" size="300, 16" font="small-font" font-color="text-dim" transparent="true" text-alignment="left" mouse-enabled="false" tooltip="How endpoint A sounds: shape, colour and force."/>
          <view class="CTextLabel" session-tag="9221" title="" origin="328, 46" size="300, 16" font="small-font" font-color="text-dim" transparent="true" text-alignment="right" mouse-enabled="false" tooltip="How endpoint B sounds: shape, colour and force."/>
          <view class="CTextLabel" title="A" origin="8, 74" size="16, 16" font="label-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="CSlider" control-tag="MorphPosition" origin="28, 70" size="476, 24" orientation="horizontal" draw-frame="true" draw-back="true" draw-value="true" frame-color="accent" back-color="track" value-color="accent" tooltip="Bass Morph: moves the sound from endpoint A (0 %) to endpoint B (100 %). Automate it to travel between two complete sounds."/>
          <view class="CTextLabel" title="B" origin="508, 74" size="16, 16" font="label-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="CParamDisplay" control-tag="MorphPosition" origin="532, 72" size="96, 20" font="label-font" font-color="text" transparent="true" text-alignment="right" tooltip="Bass Morph: moves the sound from endpoint A (0 %) to endpoint B (100 %). Automate it to travel between two complete sounds."/>
          <view class="CTextLabel" title="COMPARE" origin="8, 104" size="80, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="CSegmentButton" session-tag="9200" origin="8, 122" size="180, 24" style="horizontal" selection-mode="Single" font="small-font" text-color="text" text-color-highlighted="bg" frame-color="track" frame-width="1" round-radius="0" gradient="segment-off" gradient-highlighted="segment-on" segment-names="A,A·B,B" tooltip="Compare: hear endpoint A, the morph, or endpoint B. Pressing A or B also sets Edit Target."/>
          <view class="CTextButton" session-tag="9201" title="COPY A → B" origin="200, 122" size="120, 24" font="small-font" text-color="text" text-color-highlighted="bg" frame-color="track" frame-width="1" round-radius="0" gradient="segment-off" gradient-highlighted="segment-on" kick-style="true" tooltip="Copy endpoint A's sound onto B. The name is not copied."/>
          <view class="CTextButton" session-tag="9202" title="COPY B → A" origin="328, 122" size="120, 24" font="small-font" text-color="text" text-color-highlighted="bg" frame-color="track" frame-width="1" round-radius="0" gradient="segment-off" gradient-highlighted="segment-on" kick-style="true" tooltip="Copy endpoint B's sound onto A. The name is not copied."/>
          <view class="CTextLabel" title="EDIT" origin="8, 154" size="80, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="CSegmentButton" control-tag="MorphEditTarget" origin="8, 172" size="120, 24" style="horizontal" selection-mode="Single" font="small-font" text-color="text" text-color-highlighted="bg" frame-color="track" frame-width="1" round-radius="0" gradient="segment-off" gradient-highlighted="segment-on" tooltip="Edit Target: whether the knobs edit endpoint A or endpoint B. It changes what you edit, not what you hear. Not automatable."/>
        </view>
      </view>
    </view>
    <view class="CViewContainer" uidesc-label="page-advanced" origin="0, 56" size="960, 544" background-color="bg" background-color-draw-style="filled" transparent="false">
      <view class="CSegmentButton" uidesc-label="tab-strip" session-tag="9110" origin="8, 2" size="360, 24" style="horizontal" selection-mode="Single" font="small-font" text-color="text" text-color-highlighted="bg" frame-color="track" frame-width="1" round-radius="0" gradient="segment-off" gradient-highlighted="segment-on" segment-names="SECTIONS,MODULATION,SETTINGS" tooltip="Advanced page sections: choose which group of controls to show."/>
      <view class="CViewContainer" uidesc-label="tab-sections" origin="0, 28" size="960, 516" background-color="bg" background-color-draw-style="filled" transparent="false">
        <view class="CViewContainer" uidesc-label="section-core-spectrum" origin="8, 0" size="304, 220" background-color="panel" background-color-draw-style="filled" transparent="false">
          <view class="CTextLabel" title="CORE SPECTRUM" origin="4, 2" size="200, 16" font="section-font" font-color="accent" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="CView" custom-view-name="HarmonicBarView" uidesc-label="bars-core" bar-variant="core" origin="4, 20" size="296, 88" tooltip="The measured harmonics of the sounding note after Fold and Character, before the amp envelope, in dB below the strongest component. Shows the resolved sound, including morph, macros and Motion."/>
          <view class="CTextLabel" title="Depth" origin="4, 117" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="OffsetRingKnob" control-tag="CoreDepth" origin="124, 113" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Depth: how steeply the harmonics fall away above the fundamental. Higher is rounder, lower is richer."/>
          <view class="CTextLabel" title="Body" origin="156, 117" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="OffsetRingKnob" control-tag="CoreBody" origin="276, 113" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Body: lifts the low harmonics (about 2 to 8) that carry the bass's body."/>
          <view class="CTextLabel" title="Body Curvature" origin="4, 143" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="ArcKnob" control-tag="CoreBodyCurvature" origin="124, 139" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Body Curvature: narrows or broadens the region Body lifts."/>
          <view class="CTextLabel" title="Body Emphasis" origin="156, 143" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="ArcKnob" control-tag="CoreBodyEmphasis" origin="276, 139" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Body Emphasis: at 0 all harmonics sound; toward −100 % the even harmonics fade for a hollower tone."/>
          <view class="CTextLabel" title="Edge" origin="4, 169" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="OffsetRingKnob" control-tag="CoreEdge" origin="124, 165" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Edge: lifts the upper harmonics that give the bass its bite."/>
          <view class="CTextLabel" title="Spectral Shift" origin="156, 169" size="94, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="BipolarSlider" control-tag="CoreShift" origin="252, 165" size="50, 24" fill-color="accent" track-color="track" center-tick-color="text-dim" tooltip="Spectral Shift: moves the Body and Edge regions down (darker) or up (brighter) together."/>
          <view class="CTextLabel" title="Harmonic Fold" origin="4, 195" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="OffsetRingKnob" control-tag="FoldAmount" origin="124, 191" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Harmonic Fold: folds the waveform back on itself to add new harmonics. 0 is clean."/>
          <view class="CTextLabel" title="Tight/Loose" origin="156, 195" size="94, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="BipolarSlider" control-tag="MacroTightLoose" origin="252, 191" size="50, 24" fill-color="accent" track-color="track" center-tick-color="text-dim" tooltip="Tight ↔ Loose: toward Tight, shorter attack, decay and release, a harder transient and more Compression; toward Loose the reverse. Compression has no control of its own."/>
        </view>
        <view class="CViewContainer" uidesc-label="section-excitation-fold" origin="8, 228" size="304, 76" background-color="panel" background-color-draw-style="filled" transparent="false">
          <view class="CTextLabel" title="EXCITATION &amp; FOLD" origin="4, 2" size="200, 16" font="section-font" font-color="accent" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="CTextLabel" title="Excitation Drive" origin="4, 25" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="OffsetRingKnob" control-tag="CoreExcitationDrive" origin="124, 21" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Excitation Drive: how hard the excitation stage is driven. More drive grows more new harmonics; it is heard only when Excitation Mix is above 0."/>
          <view class="CTextLabel" title="Excitation Mix" origin="156, 25" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="OffsetRingKnob" control-tag="CoreExcitationMix" origin="276, 21" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Excitation Mix: blends the driven excitation into the clean tone. 0 is clean."/>
          <view class="CTextLabel" title="Excitation Asymmetry" origin="4, 51" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="ArcKnob" control-tag="CoreExcitationAsymmetry" origin="124, 47" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Excitation Asymmetry: biases the drive for uneven, even-harmonic grit."/>
          <view class="CTextLabel" title="Harmonic Fold" origin="156, 51" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="OffsetRingKnob" control-tag="FoldAmount" origin="276, 47" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Harmonic Fold: folds the waveform back on itself to add new harmonics. 0 is clean."/>
        </view>
        <view class="CViewContainer" uidesc-label="section-shape-character" origin="8, 312" size="304, 76" background-color="panel" background-color-draw-style="filled" transparent="false">
          <view class="CTextLabel" title="SHAPE &amp; CHARACTER" origin="4, 2" size="200, 16" font="section-font" font-color="accent" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="CTextLabel" title="Shape" origin="4, 25" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="ArcKnob" control-tag="FoldShape" origin="124, 21" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Shape: the SHAPE stage, one control across three characters: 0 % ROUND (soft and dark), 50 % HOLLOW (resonant and scooped), 100 % BITE (bright and edgy)."/>
          <view class="CTextLabel" title="Character" origin="156, 25" size="60, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="COptionMenu" control-tag="Character" origin="218, 23" size="84, 20" font="small-font" font-color="text" frame-color="accent" back-color="track" frame-width="1" transparent="false" style-3D-in="false" style-3D-out="false" tooltip="Character: the type of colouring stage: Tube, Wavefold, Rectify, Bite, Crush or Fracture. Character Amount sets how much is heard. In WIDE, left and right get slightly different Character settings, so the sub is a little less mono than in Solid or Spread."/>
          <view class="CTextLabel" title="Character Amount" origin="4, 51" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="OffsetRingKnob" control-tag="CharacterAmount" origin="124, 47" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Character Amount: how much of the Character stage is heard. 0 is off. In WIDE, left and right get slightly different Character settings, so the sub is a little less mono than in Solid or Spread."/>
          <view class="CTextLabel" title="Character Tone" origin="156, 51" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="OffsetRingKnob" control-tag="CharacterTone" origin="276, 47" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Character Tone: darkens or brightens the Character stage. In WIDE, left and right get slightly different Character settings, so the sub is a little less mono than in Solid or Spread."/>
        </view>
        <view class="CViewContainer" uidesc-label="section-mass" origin="8, 396" size="304, 50" background-color="panel" background-color-draw-style="filled" transparent="false">
          <view class="CTextLabel" title="MASS" origin="4, 2" size="200, 16" font="section-font" font-color="accent" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="CTextLabel" title="Transient Attack" origin="4, 25" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="OffsetRingKnob" control-tag="DynamicsTransientAttack" origin="124, 21" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Transient Attack: boosts or softens the start of each note, −12 to +12 dB."/>
          <view class="CTextLabel" title="Transient Sustain" origin="156, 25" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="ArcKnob" control-tag="DynamicsTransientSustain" origin="276, 21" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Transient Sustain: boosts or softens the body that follows the start, −12 to +12 dB."/>
        </view>
        <view class="CViewContainer" uidesc-label="section-sub-anchor" origin="328, 0" size="304, 180" background-color="panel" background-color-draw-style="filled" transparent="false">
          <view class="CTextLabel" title="SUB ANCHOR" origin="4, 2" size="200, 16" font="section-font" font-color="accent" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="CTextLabel" uidesc-label="held-at-a" title="Held at A" origin="200, 2" size="100, 16" font="small-font" font-color="text-dim" transparent="true" text-alignment="right" mouse-enabled="false" tooltip="Hold is on and you are editing B: B's sub settings are stored but not heard."/>
          <view class="CTextLabel" title="Anchor Waveform" origin="4, 25" size="96, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="COptionMenu" control-tag="AnchorWaveform" origin="104, 23" size="196, 20" font="small-font" font-color="text" frame-color="accent" back-color="track" frame-width="1" transparent="false" style-3D-in="false" style-3D-out="false" tooltip="Anchor Waveform: the shape of the sub tone: Sine (purest), Triangle, Rounded Sine, Asymmetric Sine or Octave Down (one octave below the note)."/>
          <view class="CTextLabel" title="Anchor Level" origin="4, 51" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="OffsetRingKnob" control-tag="AnchorLevel" origin="124, 47" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Anchor Level: level of the pure sub tone under the bass. It stays centred and outside the drive stages."/>
          <view class="CTextLabel" title="Anchor Fold Feed" origin="156, 51" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="ArcKnob" control-tag="AnchorFoldFeed" origin="276, 47" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Anchor Fold Feed: sends some of the sub tone into Harmonic Fold, so the fold works on the sub too. 0 keeps the sub clean."/>
          <view class="CTextLabel" title="ANCHOR MODE" origin="4, 77" size="96, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="CSegmentButton" control-tag="AnchorMode" origin="104, 73" size="196, 24" style="horizontal" selection-mode="Single" font="small-font" text-color="text" text-color-highlighted="bg" frame-color="track" frame-width="1" round-radius="0" gradient="segment-off" gradient-highlighted="segment-on" tooltip="Anchor Mode: how the sub tone behaves: Lock stays constant, Follow tracks the pitch you hear, Punch is louder at the note start, Ghost fades in after it."/>
          <view class="CTextLabel" title="Punch Boost" origin="4, 103" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="ArcKnob" control-tag="AnchorPunchBoost" origin="124, 99" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Punch Boost: extra sub level at the note start in Punch mode, 0 to +12 dB."/>
          <view class="CTextLabel" title="Punch Time" origin="156, 103" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="ArcKnob" control-tag="AnchorPunchTime" origin="276, 99" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Punch Time: how long the Punch boost lasts, 5 to 250 ms."/>
          <view class="CTextLabel" title="Ghost Time" origin="4, 129" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="ArcKnob" control-tag="AnchorGhostTime" origin="124, 125" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Ghost Time: in Ghost mode, how long the sub tone takes to emerge after the note starts, 1 to 100 ms."/>
          <view class="CTextLabel" title="MORPH BEHAVIOUR" origin="4, 155" size="96, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="CSegmentButton" control-tag="MorphAnchorMode" origin="104, 151" size="196, 24" style="horizontal" selection-mode="Single" font="small-font" text-color="text" text-color-highlighted="bg" frame-color="track" frame-width="1" round-radius="0" gradient="segment-off" gradient-highlighted="segment-on" tooltip="Morph behaviour of the sub tone: Hold keeps A's sub, Blend follows the morph, Yield hands over late."/>
        </view>
        <view class="CViewContainer" uidesc-label="section-stereo-output" origin="328, 188" size="304, 302" background-color="panel" background-color-draw-style="filled" transparent="false">
          <view class="CTextLabel" title="STEREO &amp; OUTPUT" origin="4, 2" size="200, 16" font="section-font" font-color="accent" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="CTextLabel" title="Image" origin="4, 25" size="96, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="CSegmentButton" control-tag="FieldImageMode" origin="104, 21" size="196, 24" style="horizontal" selection-mode="Single" font="small-font" text-color="text" text-color-highlighted="bg" frame-color="track" frame-width="1" round-radius="0" gradient="segment-off" gradient-highlighted="segment-on" tooltip="Image Mode: Solid is mono, Spread widens the upper harmonics above the crossover, Wide also gives left and right slightly different Character settings. Mono-safe: width only pans, so the sub stays centred (correlation ≥ 0.9989), and even at Gravity 0 the sides below twice the crossover are cut by 29 dB."/>
          <view class="CView" custom-view-name="SpreadCurveView" uidesc-label="spread-curve" origin="4, 48" size="296, 64" tooltip="How wide each frequency is for the endpoint being edited: 0 is mono, 1 is fully wide. Field Motion is not drawn."/>
          <view class="CTextLabel" title="Spread" origin="4, 121" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="ArcKnob" control-tag="FieldSpread" origin="124, 117" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Spread: overall stereo width above the crossover. 0 is centred. Mono-safe: width only pans, so the sub stays centred (correlation ≥ 0.9989), and even at Gravity 0 the sides below twice the crossover are cut by 29 dB."/>
          <view class="CTextLabel" title="Gravity" origin="156, 121" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="ArcKnob" control-tag="FieldGravity" origin="276, 117" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Gravity: how far below the crossover the width begins. At 0 the width reaches lowest; at 100 % the low band is pulled firmly to the centre. Mono-safe: width only pans, so the sub stays centred (correlation ≥ 0.9989), and even at Gravity 0 the sides below twice the crossover are cut by 29 dB."/>
          <view class="CTextLabel" title="Crossover" origin="4, 147" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="ArcKnob" control-tag="FieldCrossover" origin="124, 143" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Crossover: the frequency below which the bass stays centred, 60 to 250 Hz. Mono-safe: width only pans, so the sub stays centred (correlation ≥ 0.9989), and even at Gravity 0 the sides below twice the crossover are cut by 29 dB."/>
          <view class="CTextLabel" title="Curve" origin="156, 147" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="ArcKnob" control-tag="FieldCurve" origin="276, 143" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Curve: how quickly the width rises between the low and high knees. Mono-safe: width only pans, so the sub stays centred (correlation ≥ 0.9989), and even at Gravity 0 the sides below twice the crossover are cut by 29 dB."/>
          <view class="CTextLabel" title="Field Motion Depth" origin="4, 173" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="ArcKnob" control-tag="FieldMotionDepth" origin="124, 169" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Field Motion Depth: how much the width moves over time. 0 holds it still. Mono-safe: width only pans, so the sub stays centred (correlation ≥ 0.9989), and even at Gravity 0 the sides below twice the crossover are cut by 29 dB."/>
          <view class="CTextLabel" title="Field Motion Rate" origin="156, 173" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="ArcKnob" control-tag="FieldMotionRate" origin="276, 169" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Field Motion Rate: speed of the width movement. Cycle runs from 0.05 to 1 Hz; Drift wanders from slowly to quickly. Mono-safe: width only pans, so the sub stays centred (correlation ≥ 0.9989), and even at Gravity 0 the sides below twice the crossover are cut by 29 dB."/>
          <view class="CTextLabel" title="Field Motion Source" origin="4, 199" size="96, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="CSegmentButton" control-tag="FieldMotionSource" origin="104, 195" size="196, 24" style="horizontal" selection-mode="Single" font="small-font" text-color="text" text-color-highlighted="bg" frame-color="track" frame-width="1" round-radius="0" gradient="segment-off" gradient-highlighted="segment-on" tooltip="Field Motion Source: Drift wanders, Cycle repeats. Mono-safe: width only pans, so the sub stays centred (correlation ≥ 0.9989), and even at Gravity 0 the sides below twice the crossover are cut by 29 dB."/>
          <view class="CTextLabel" title="Field Sync" origin="4, 225" size="62, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="CSegmentButton" control-tag="FieldSync" origin="68, 221" size="80, 24" style="horizontal" selection-mode="Single" font="small-font" text-color="text" text-color-highlighted="bg" frame-color="track" frame-width="1" round-radius="0" gradient="segment-off" gradient-highlighted="segment-on" tooltip="Field Sync: lock the width movement to the host tempo; Field Sync Rate then sets the note value. Mono-safe: width only pans, so the sub stays centred (correlation ≥ 0.9989), and even at Gravity 0 the sides below twice the crossover are cut by 29 dB."/>
          <view class="CTextLabel" title="Field Sync Rate" origin="156, 225" size="60, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="COptionMenu" control-tag="FieldSyncRate" origin="218, 223" size="84, 20" font="small-font" font-color="text" frame-color="accent" back-color="track" frame-width="1" transparent="false" style-3D-in="false" style-3D-out="false" tooltip="Field Sync Rate: note value of the synced width movement. Synced rates above 1 Hz fold into 0.5–1 Hz. Mono-safe: width only pans, so the sub stays centred (correlation ≥ 0.9989), and even at Gravity 0 the sides below twice the crossover are cut by 29 dB."/>
          <view class="CTextLabel" title="Output Gain" origin="4, 251" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="ArcKnob" control-tag="OutputGain" origin="124, 247" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Output Gain: final level after the limiter, from silence up to 0 dB. It only turns down, so it never pushes past the Output Ceiling."/>
          <view class="CTextLabel" title="Polyphony" origin="156, 251" size="60, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="COptionMenu" control-tag="Polyphony" origin="218, 249" size="84, 20" font="small-font" font-color="text" frame-color="accent" back-color="track" frame-width="1" transparent="false" style-3D-in="false" style-3D-out="false" tooltip="Polyphony: how many notes can sound at once in Poly (1 to 8). Mono ignores it."/>
          <view class="CTextLabel" title="Output Ceiling" origin="4, 277" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="ArcKnob" control-tag="OutputCeiling" origin="124, 273" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Output Ceiling: the highest true-peak level the output reaches (−12 to 0 dBTP, default −1). The limiter holds everything under it."/>
        </view>
        <view class="CViewContainer" uidesc-label="section-pitch-envelopes" origin="648, 0" size="304, 402" background-color="panel" background-color-draw-style="filled" transparent="false">
          <view class="CTextLabel" title="PITCH &amp; ENVELOPES" origin="4, 2" size="200, 16" font="section-font" font-color="accent" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="CTextLabel" title="Drop Amount" origin="4, 25" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="ArcKnob" control-tag="DropAmount" origin="124, 21" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Drop Amount: how far the pitch falls into each note, in semitones."/>
          <view class="CTextLabel" title="Drop Time" origin="156, 25" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="ArcKnob" control-tag="DropTime" origin="276, 21" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Drop Time: how long the pitch drop takes, from 1 ms to 4 s."/>
          <view class="CTextLabel" title="Drop Shape" origin="4, 51" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="ArcKnob" control-tag="DropShape" origin="124, 47" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Drop Shape: the curve of the pitch drop: 0 % exponential (fast, then slow), 33 % linear, 67 % logarithmic (slow, then fast), 100 % elastic (it overshoots and settles)."/>
          <view class="CTextLabel" title="Drop Rebound" origin="156, 51" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="ArcKnob" control-tag="DropRebound" origin="276, 47" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Drop Rebound: how much the pitch overshoots and settles at the end of the drop."/>
          <view class="ADSRDisplay" control-tag="AmpAttack" uidesc-label="amp-envelope" origin="4, 74" size="296, 60" fill-color="track" stroke-color="accent" control-point-color="text" background-color="panel" grid-color="track" text-color="text-dim" tooltip="Amp envelope: drag the points to set Attack, Decay, Sustain and Release."/>
          <view class="CTextLabel" title="Attack" origin="4, 143" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="OffsetRingKnob" control-tag="AmpAttack" origin="124, 139" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Attack: time to full level after a note starts, 0.1 ms to 10 s."/>
          <view class="CTextLabel" title="Decay" origin="156, 143" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="OffsetRingKnob" control-tag="AmpDecay" origin="276, 139" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Decay: time to fall from full level to the Sustain level, 0.1 ms to 10 s."/>
          <view class="CTextLabel" title="Sustain" origin="4, 169" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="ArcKnob" control-tag="AmpSustain" origin="124, 165" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Sustain: level held while the key is down, 0 to 100 %."/>
          <view class="CTextLabel" title="Release" origin="156, 169" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="OffsetRingKnob" control-tag="AmpRelease" origin="276, 165" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Release: time to silence after the key is released, 0.1 ms to 10 s."/>
          <view class="CTextLabel" title="Attack Curve" origin="4, 195" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="ArcKnob" control-tag="AmpAttackCurve" origin="124, 191" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Attack Curve: bends the attack segment. 0 is a straight line, + is exponential, − is logarithmic."/>
          <view class="CTextLabel" title="Decay Curve" origin="156, 195" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="ArcKnob" control-tag="AmpDecayCurve" origin="276, 191" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Decay Curve: bends the decay segment. 0 is a straight line, + is exponential, − is logarithmic."/>
          <view class="CTextLabel" title="Release Curve" origin="4, 221" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="ArcKnob" control-tag="AmpReleaseCurve" origin="124, 217" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Release Curve: bends the release segment. 0 is a straight line, + is exponential, − is logarithmic."/>
          <view class="CTextLabel" title="Pitch Bend Range" origin="156, 221" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="ArcKnob" control-tag="NotePitchBendRange" origin="276, 217" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Pitch Bend Range: how far the bend wheel bends, 0 to 24 semitones each way."/>
          <view class="CTextLabel" title="Mono Priority" origin="4, 247" size="96, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="CSegmentButton" control-tag="NoteMonoPriority" origin="104, 243" size="196, 24" style="horizontal" selection-mode="Single" font="small-font" text-color="text" text-color-highlighted="bg" frame-color="track" frame-width="1" round-radius="0" gradient="segment-off" gradient-highlighted="segment-on" tooltip="Mono Priority: which held note sounds in Mono: Last, Low or High."/>
          <view class="CTextLabel" title="Legato" origin="4, 273" size="62, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="CSegmentButton" control-tag="NoteLegato" origin="68, 269" size="80, 24" style="horizontal" selection-mode="Single" font="small-font" text-color="text" text-color-highlighted="bg" frame-color="track" frame-width="1" round-radius="0" gradient="segment-off" gradient-highlighted="segment-on" tooltip="Legato: overlapping notes glide without restarting the envelope."/>
          <view class="CTextLabel" title="Portamento" origin="156, 273" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="ArcKnob" control-tag="NotePortamento" origin="276, 269" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Portamento: glide time between notes, from 0 (off) to 10 s. Glide Mode decides whether this is a time or a rate."/>
          <view class="CTextLabel" title="Portamento Mode" origin="4, 299" size="96, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="CSegmentButton" control-tag="NotePortamentoMode" origin="104, 295" size="196, 24" style="horizontal" selection-mode="Single" font="small-font" text-color="text" text-color-highlighted="bg" frame-color="track" frame-width="1" round-radius="0" gradient="segment-off" gradient-highlighted="segment-on" tooltip="Portamento Mode: glide on every note, or only between overlapping notes."/>
          <view class="CTextLabel" title="Glide Mode" origin="4, 325" size="96, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="CSegmentButton" control-tag="NoteGlideMode" origin="104, 321" size="196, 24" style="horizontal" selection-mode="Single" font="small-font" text-color="text" text-color-highlighted="bg" frame-color="track" frame-width="1" round-radius="0" gradient="segment-off" gradient-highlighted="segment-on" tooltip="Glide Mode: Constant Time takes the same time for any interval, Constant Rate takes longer for wider intervals, Quantized steps through the semitones."/>
          <view class="CTextLabel" title="Note Memory" origin="4, 351" size="96, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="COptionMenu" control-tag="NoteMemory" origin="104, 349" size="196, 20" font="small-font" font-color="text" frame-color="accent" back-color="track" frame-width="1" transparent="false" style-3D-in="false" style-3D-out="false" tooltip="Note Memory: what carries over between notes in Mono: Always Retrigger restarts everything, Legato carries on across overlapping notes, Envelope Retrigger restarts only the envelope, Oscillator Continuous keeps the waveform running."/>
          <view class="CTextLabel" title="Note Retrigger" origin="4, 377" size="96, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="CSegmentButton" control-tag="NoteRetrigger" origin="104, 373" size="196, 24" style="horizontal" selection-mode="Single" font="small-font" text-color="text" text-color-highlighted="bg" frame-color="track" frame-width="1" round-radius="0" gradient="segment-off" gradient-highlighted="segment-on" tooltip="Note Retrigger: Reset restarts the note's movement, Continue carries it on."/>
        </view>
        <view class="CViewContainer" uidesc-label="section-morph-behaviour" origin="648, 410" size="304, 102" background-color="panel" background-color-draw-style="filled" transparent="false">
          <view class="CTextLabel" title="MORPH BEHAVIOUR" origin="4, 2" size="200, 16" font="section-font" font-color="accent" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="CTextLabel" title="MORPH BEHAVIOUR" origin="4, 25" size="96, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="CSegmentButton" control-tag="MorphAnchorMode" origin="104, 21" size="196, 24" style="horizontal" selection-mode="Single" font="small-font" text-color="text" text-color-highlighted="bg" frame-color="track" frame-width="1" round-radius="0" gradient="segment-off" gradient-highlighted="segment-on" tooltip="Morph behaviour of the sub tone: Hold keeps A's sub, Blend follows the morph, Yield hands over late."/>
          <view class="CTextLabel" title="Compare" origin="4, 51" size="52, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="CSegmentButton" session-tag="9203" origin="60, 47" size="108, 24" style="horizontal" selection-mode="Single" font="small-font" text-color="text" text-color-highlighted="bg" frame-color="track" frame-width="1" round-radius="0" gradient="segment-off" gradient-highlighted="segment-on" segment-names="A,A·B,B" tooltip="Compare: hear A, the morph, or B. Choosing A or B also edits that side."/>
          <view class="CTextLabel" title="Morph Ramp Time" origin="174, 51" size="96, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
          <view class="ArcKnob" control-tag="MorphRampTime" origin="276, 47" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Morph smoothing: how quickly the sound follows a change of the morph position, 5 ms to 2 s. Longer glides smoothly between A and B."/>
          <view class="CTextButton" session-tag="9204" title="Copy A → B" origin="4, 73" size="144, 24" font="small-font" text-color="text" text-color-highlighted="bg" frame-color="track" frame-width="1" round-radius="0" gradient="segment-off" gradient-highlighted="segment-on" kick-style="true" tooltip="Copy A's sound to B. Names are not copied."/>
          <view class="CTextButton" session-tag="9205" title="Copy B → A" origin="152, 73" size="148, 24" font="small-font" text-color="text" text-color-highlighted="bg" frame-color="track" frame-width="1" round-radius="0" gradient="segment-off" gradient-highlighted="segment-on" kick-style="true" tooltip="Copy B's sound to A. Names are not copied."/>
        </view>
      </view>
      <view class="CViewContainer" uidesc-label="tab-modulation" origin="0, 28" size="960, 516" background-color="panel" background-color-draw-style="filled" transparent="false">
        <view class="CTextLabel" title="SOURCE" origin="12, 4" size="200, 16" font="section-font" font-color="accent" transparent="true" text-alignment="left" mouse-enabled="false"/>
        <view class="CTextLabel" title="Motion Source" origin="12, 29" size="96, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
        <view class="CSegmentButton" control-tag="MotionSource" origin="112, 25" size="196, 24" style="horizontal" selection-mode="Single" font="small-font" text-color="text" text-color-highlighted="bg" frame-color="track" frame-width="1" round-radius="0" gradient="segment-off" gradient-highlighted="segment-on" tooltip="Motion Source: what moves the target: Env rises and falls with each note, Cycle repeats, Drift wanders. Off disables Motion."/>
        <view class="CTextLabel" title="Motion Target" origin="12, 55" size="96, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
        <view class="COptionMenu" control-tag="MotionTarget" origin="112, 53" size="196, 20" font="small-font" font-color="text" frame-color="accent" back-color="track" frame-width="1" transparent="false" style-3D-in="false" style-3D-out="false" tooltip="Motion Target: what Motion moves: Mass, Depth, Body, Edge or Shift."/>
        <view class="CTextLabel" title="Motion Amount" origin="12, 81" size="96, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
        <view class="BipolarSlider" control-tag="MotionAmount" origin="112, 77" size="196, 24" fill-color="accent" track-color="track" center-tick-color="text-dim" tooltip="Motion Amount: how far and in which direction Motion moves its target."/>
        <view class="CTextLabel" title="Motion Depth" origin="12, 107" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="MotionDepth" origin="132, 103" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Motion Depth: scales all of Motion at once, 0 to 100 %. Motion Amount sets the direction and size for the target."/>
        <view class="CTextLabel" title="CYCLE" origin="332, 4" size="200, 16" font="section-font" font-color="accent" transparent="true" text-alignment="left" mouse-enabled="false"/>
        <view class="CTextLabel" title="Cycle Rate" origin="332, 29" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="MotionCycleRate" origin="452, 25" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Cycle Rate: speed of the Cycle source, 0.01 to 20 Hz, when Cycle Sync is off."/>
        <view class="CTextLabel" title="Cycle Phase" origin="484, 29" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="MotionCyclePhase" origin="604, 25" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Cycle Phase: where in its waveform the Cycle starts, 0 to 360°."/>
        <view class="CTextLabel" title="Cycle Shape" origin="332, 55" size="96, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
        <view class="COptionMenu" control-tag="MotionCycleShape" origin="432, 53" size="196, 20" font="small-font" font-color="text" frame-color="accent" back-color="track" frame-width="1" transparent="false" style-3D-in="false" style-3D-out="false" tooltip="Cycle Shape: waveform of the Cycle source: Sine, Triangle, Sawtooth, Square, S&amp;H or Smooth Random."/>
        <view class="CTextLabel" title="Cycle Sync" origin="332, 81" size="96, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
        <view class="CSegmentButton" control-tag="MotionCycleSync" origin="432, 77" size="196, 24" style="horizontal" selection-mode="Single" font="small-font" text-color="text" text-color-highlighted="bg" frame-color="track" frame-width="1" round-radius="0" gradient="segment-off" gradient-highlighted="segment-on" tooltip="Cycle Sync: lock the Cycle to the host tempo; Cycle Sync Rate then sets the note value."/>
        <view class="CTextLabel" title="Cycle Sync Rate" origin="332, 107" size="96, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
        <view class="COptionMenu" control-tag="MotionCycleSyncRate" origin="432, 105" size="196, 20" font="small-font" font-color="text" frame-color="accent" back-color="track" frame-width="1" transparent="false" style-3D-in="false" style-3D-out="false" tooltip="Cycle Sync Rate: note value of one synced Cycle, 1/64T to 4/1D."/>
        <view class="CTextLabel" title="Cycle Retrigger" origin="332, 133" size="96, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
        <view class="CSegmentButton" control-tag="MotionCycleRetrigger" origin="432, 129" size="196, 24" style="horizontal" selection-mode="Single" font="small-font" text-color="text" text-color-highlighted="bg" frame-color="track" frame-width="1" round-radius="0" gradient="segment-off" gradient-highlighted="segment-on" tooltip="Cycle Retrigger: restart the Cycle at its start phase on each new note. Off lets it run freely."/>
        <view class="CTextLabel" title="Cycle Fade-In" origin="332, 159" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="MotionCycleFadeIn" origin="452, 155" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Cycle Fade-In: time for the Cycle to reach full depth after a note starts, 0 to 5 s."/>
        <view class="CTextLabel" title="ENV &amp; DRIFT" origin="652, 4" size="200, 16" font="section-font" font-color="accent" transparent="true" text-alignment="left" mouse-enabled="false"/>
        <view class="CTextLabel" title="Motion Polarity" origin="652, 29" size="96, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
        <view class="CSegmentButton" control-tag="MotionPolarity" origin="752, 25" size="196, 24" style="horizontal" selection-mode="Single" font="small-font" text-color="text" text-color-highlighted="bg" frame-color="track" frame-width="1" round-radius="0" gradient="segment-off" gradient-highlighted="segment-on" tooltip="Motion Polarity: Bipolar ENV rests at −amount between notes; Unipolar rests at the set value."/>
        <view class="CTextLabel" title="Env Attack" origin="652, 55" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="MotionEnvAttack" origin="772, 51" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Env Attack: rise time of the Env source, 0.1 ms to 10 s."/>
        <view class="CTextLabel" title="Env Decay" origin="804, 55" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="MotionEnvDecay" origin="924, 51" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Env Decay: fall time of the Env source back to rest, 0.1 ms to 10 s."/>
        <view class="CTextLabel" title="Drift Smoothness" origin="652, 81" size="118, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
        <view class="ArcKnob" control-tag="MotionDriftSmoothness" origin="772, 77" size="24, 24" arc-color="accent" guide-color="track" mod-color="highlight" tooltip="Drift Smoothness: how smoothly the Drift source wanders. Higher is gentler."/>
      </view>
      <view class="CViewContainer" uidesc-label="tab-settings" origin="0, 28" size="960, 516" background-color="panel" background-color-draw-style="filled" transparent="false">
        <view class="CTextLabel" title="SETTINGS" origin="12, 4" size="200, 16" font="section-font" font-color="accent" transparent="true" text-alignment="left" mouse-enabled="false"/>
        <view class="CTextLabel" title="Zoom" origin="12, 29" size="92, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
        <view class="CSegmentButton" uidesc-label="zoom-settings" session-tag="9300" origin="112, 25" size="196, 24" style="horizontal" selection-mode="Single" font="small-font" text-color="text" text-color-highlighted="bg" frame-color="track" frame-width="1" round-radius="0" gradient="segment-off" gradient-highlighted="segment-on" segment-names="100%,125%,150%,200%" tooltip="Window size: 100, 125, 150 or 200 %. Kept for the session, not saved with the project."/>
        <view class="CTextLabel" title="No host run loop: the spectrum view stays empty" origin="12, 58" size="500, 16" font="small-font" font-color="text" transparent="true" text-alignment="left" mouse-enabled="false"/>
      </view>
    </view>
  </template>
</vstgui-ui-description>
