   <gradients>
      <gradient name="segment-bg">
         <color-stop rgba="#2a2a33ff" start="0"/>
         <color-stop rgba="#24242cff" start="1"/>
      </gradient>
      <gradient name="segment-bg-selected">
         <color-stop rgba="#3568a0ff" start="0"/>
         <color-stop rgba="#2e5a88ff" start="1"/>
      </gradient>
   </gradients>
   <template name="GranularPanel" class="CViewContainer" origin="0, 0" size="900, 480" background-color="panel" transparent="false">
      <view class="CViewContainer" origin="12, 12" size="284, 72" transparent="true" sub-controller="GranularTimeSyncController">
         <view class="ArcKnob" origin="8, 8" size="56, 56" control-tag="GranularDelayTime" arc-color="accent" guide-color="slider-frame" arc-width="3"/>
         <view class="CTextLabel" origin="76, 10" size="120, 16" title="Time" font="label-font" font-color="text-dim" text-alignment="left" transparent="true"/>
         <view class="CParamDisplay" origin="76, 30" size="120, 24" control-tag="GranularDelayTime" font="readout-font" font-color="text" text-alignment="left" back-color="~ TransparentCColor" frame-color="~ TransparentCColor" style-no-frame="true"/>
         <view class="ToggleButton" origin="200, 32" size="76, 22" control-tag="GranularTimeMode" title="Sync" title-position="right" icon-style="power" icon-size="0.6" font="label-font" on-color="accent" off-color="text-dim"/>
      </view>
      <view class="CViewContainer" origin="308, 12" size="284, 72" transparent="true">
         <view class="ArcKnob" origin="8, 8" size="56, 56" control-tag="GranularFeedback" arc-color="accent" guide-color="slider-frame" arc-width="3"/>
         <view class="CTextLabel" origin="76, 10" size="120, 16" title="Feedback" font="label-font" font-color="text-dim" text-alignment="left" transparent="true"/>
         <view class="CParamDisplay" origin="76, 30" size="120, 24" control-tag="GranularFeedback" font="readout-font" font-color="text" text-alignment="left" back-color="~ TransparentCColor" frame-color="~ TransparentCColor" style-no-frame="true"/>
      </view>
      <view class="CViewContainer" origin="604, 12" size="284, 72" transparent="true">
         <view class="ArcKnob" origin="8, 8" size="56, 56" control-tag="GranularDryWet" arc-color="accent" guide-color="slider-frame" arc-width="3"/>
         <view class="CTextLabel" origin="76, 10" size="120, 16" title="Mix" font="label-font" font-color="text-dim" text-alignment="left" transparent="true"/>
         <view class="CParamDisplay" origin="76, 30" size="120, 24" control-tag="GranularDryWet" font="readout-font" font-color="text" text-alignment="left" back-color="~ TransparentCColor" frame-color="~ TransparentCColor" style-no-frame="true"/>
         <view class="ToggleButton" origin="200, 32" size="76, 22" control-tag="GranularFreeze" title="Freeze" title-position="right" icon-style="power" icon-size="0.6" font="label-font" on-color="accent" off-color="text-dim"/>
      </view>
      <view class="FieldsetContainer" origin="12, 96" size="284, 180" fieldset-title="GRAIN" fieldset-color="border" fieldset-title-color="text-dim" fieldset-font-size="11" fieldset-radius="4" fieldset-line-width="1" transparent="true">
         <view class="CTextLabel" origin="12, 24" size="196, 16" title="Grain Size" font="label-font" font-color="text-dim" text-alignment="left" transparent="true"/>
         <view class="CParamDisplay" origin="208, 24" size="64, 16" control-tag="GranularGrainSize" font="value-font" font-color="text" text-alignment="right" back-color="~ TransparentCColor" frame-color="~ TransparentCColor" style-no-frame="true"/>
         <view class="CSlider" origin="12, 46" size="260, 20" control-tag="GranularGrainSize" orientation="horizontal" draw-frame="true" draw-back="true" draw-value="true" draw-frame-color="slider-frame" draw-back-color="slider-track" draw-value-color="accent" frame-width="1" transparent="true"/>
         <view class="CTextLabel" origin="12, 76" size="196, 16" title="Density" font="label-font" font-color="text-dim" text-alignment="left" transparent="true"/>
         <view class="CParamDisplay" origin="208, 76" size="64, 16" control-tag="GranularDensity" font="value-font" font-color="text" text-alignment="right" back-color="~ TransparentCColor" frame-color="~ TransparentCColor" style-no-frame="true"/>
         <view class="CSlider" origin="12, 98" size="260, 20" control-tag="GranularDensity" orientation="horizontal" draw-frame="true" draw-back="true" draw-value="true" draw-frame-color="slider-frame" draw-back-color="slider-track" draw-value-color="accent" frame-width="1" transparent="true"/>
         <view class="CTextLabel" origin="12, 128" size="260, 16" title="Grain Envelope" font="label-font" font-color="text-dim" text-alignment="left" transparent="true"/>
         <view class="CSegmentButton" origin="12, 148" size="260, 24" control-tag="GranularEnvelopeType" style="horizontal" selection-mode="kSingle" segment-names="Hann,Trapezoid,Sine,Blackman" font="value-font" text-color="text" text-color-highlighted="text-light" frame-color="border" frame-width="1" round-radius="3" gradient="segment-bg" gradient-highlighted="segment-bg-selected"/>
      </view>
      <view class="FieldsetContainer" origin="308, 96" size="284, 180" fieldset-title="PITCH" fieldset-color="border" fieldset-title-color="text-dim" fieldset-font-size="11" fieldset-radius="4" fieldset-line-width="1" transparent="true">
         <view class="CTextLabel" origin="12, 24" size="196, 16" title="Pitch" font="label-font" font-color="text-dim" text-alignment="left" transparent="true"/>
         <view class="CParamDisplay" origin="208, 24" size="64, 16" control-tag="GranularPitch" font="value-font" font-color="text" text-alignment="right" back-color="~ TransparentCColor" frame-color="~ TransparentCColor" style-no-frame="true"/>
         <view class="CSlider" origin="12, 46" size="260, 20" control-tag="GranularPitch" orientation="horizontal" draw-frame="true" draw-back="true" draw-value="true" draw-frame-color="slider-frame" draw-back-color="slider-track" draw-value-color="accent" frame-width="1" transparent="true" draw-value-from-center="true"/>
         <view class="CViewContainer" origin="142, 46" size="1, 20" background-color="text-dim" transparent="false" mouse-enabled="false"/>
         <view class="CTextLabel" origin="12, 76" size="260, 16" title="Pitch Quantize" font="label-font" font-color="text-dim" text-alignment="left" transparent="true"/>
         <view class="COptionMenu" origin="12, 96" size="260, 24" control-tag="GranularPitchQuant" font="value-font" font-color="text" back-color="slider-track" frame-color="border" frame-width="1" style-round-rect="true" round-rect-radius="3" text-inset="6, 0" menu-popup-style="true" mouse-enabled="true" wants-focus="true"/>
         <view class="CTextLabel" origin="12, 128" size="196, 16" title="Pitch Spray" font="label-font" font-color="text-dim" text-alignment="left" transparent="true"/>
         <view class="CParamDisplay" origin="208, 128" size="64, 16" control-tag="GranularPitchSpray" font="value-font" font-color="text" text-alignment="right" back-color="~ TransparentCColor" frame-color="~ TransparentCColor" style-no-frame="true"/>
         <view class="CSlider" origin="12, 150" size="260, 20" control-tag="GranularPitchSpray" orientation="horizontal" draw-frame="true" draw-back="true" draw-value="true" draw-frame-color="slider-frame" draw-back-color="slider-track" draw-value-color="accent" frame-width="1" transparent="true"/>
      </view>
      <view class="FieldsetContainer" origin="604, 96" size="284, 180" fieldset-title="SPRAY" fieldset-color="border" fieldset-title-color="text-dim" fieldset-font-size="11" fieldset-radius="4" fieldset-line-width="1" transparent="true">
         <view class="CTextLabel" origin="12, 24" size="196, 16" title="Position Spray" font="label-font" font-color="text-dim" text-alignment="left" transparent="true"/>
         <view class="CParamDisplay" origin="208, 24" size="64, 16" control-tag="GranularPositionSpray" font="value-font" font-color="text" text-alignment="right" back-color="~ TransparentCColor" frame-color="~ TransparentCColor" style-no-frame="true"/>
         <view class="CSlider" origin="12, 46" size="260, 20" control-tag="GranularPositionSpray" orientation="horizontal" draw-frame="true" draw-back="true" draw-value="true" draw-frame-color="slider-frame" draw-back-color="slider-track" draw-value-color="accent" frame-width="1" transparent="true"/>
         <view class="CTextLabel" origin="12, 76" size="196, 16" title="Pan Spray" font="label-font" font-color="text-dim" text-alignment="left" transparent="true"/>
         <view class="CParamDisplay" origin="208, 76" size="64, 16" control-tag="GranularPanSpray" font="value-font" font-color="text" text-alignment="right" back-color="~ TransparentCColor" frame-color="~ TransparentCColor" style-no-frame="true"/>
         <view class="CSlider" origin="12, 98" size="260, 20" control-tag="GranularPanSpray" orientation="horizontal" draw-frame="true" draw-back="true" draw-value="true" draw-frame-color="slider-frame" draw-back-color="slider-track" draw-value-color="accent" frame-width="1" transparent="true"/>
         <view class="CTextLabel" origin="12, 128" size="196, 16" title="Reverse Probability" font="label-font" font-color="text-dim" text-alignment="left" transparent="true"/>
         <view class="CParamDisplay" origin="208, 128" size="64, 16" control-tag="GranularReverseProb" font="value-font" font-color="text" text-alignment="right" back-color="~ TransparentCColor" frame-color="~ TransparentCColor" style-no-frame="true"/>
         <view class="CSlider" origin="12, 150" size="260, 20" control-tag="GranularReverseProb" orientation="horizontal" draw-frame="true" draw-back="true" draw-value="true" draw-frame-color="slider-frame" draw-back-color="slider-track" draw-value-color="accent" frame-width="1" transparent="true"/>
      </view>
      <view class="FieldsetContainer" origin="12, 288" size="284, 180" fieldset-title="CHARACTER" fieldset-color="border" fieldset-title-color="text-dim" fieldset-font-size="11" fieldset-radius="4" fieldset-line-width="1" transparent="true">
         <view class="CTextLabel" origin="12, 24" size="196, 16" title="Texture" font="label-font" font-color="text-dim" text-alignment="left" transparent="true"/>
         <view class="CParamDisplay" origin="208, 24" size="64, 16" control-tag="GranularTexture" font="value-font" font-color="text" text-alignment="right" back-color="~ TransparentCColor" frame-color="~ TransparentCColor" style-no-frame="true"/>
         <view class="CSlider" origin="12, 46" size="260, 20" control-tag="GranularTexture" orientation="horizontal" draw-frame="true" draw-back="true" draw-value="true" draw-frame-color="slider-frame" draw-back-color="slider-track" draw-value-color="accent" frame-width="1" transparent="true"/>
         <view class="CTextLabel" origin="12, 76" size="196, 16" title="Timing Jitter" font="label-font" font-color="text-dim" text-alignment="left" transparent="true"/>
         <view class="CParamDisplay" origin="208, 76" size="64, 16" control-tag="GranularJitter" font="value-font" font-color="text" text-alignment="right" back-color="~ TransparentCColor" frame-color="~ TransparentCColor" style-no-frame="true"/>
         <view class="CSlider" origin="12, 98" size="260, 20" control-tag="GranularJitter" orientation="horizontal" draw-frame="true" draw-back="true" draw-value="true" draw-frame-color="slider-frame" draw-back-color="slider-track" draw-value-color="accent" frame-width="1" transparent="true"/>
      </view>
      <view class="FieldsetContainer" origin="604, 288" size="284, 180" fieldset-title="STEREO" fieldset-color="border" fieldset-title-color="text-dim" fieldset-font-size="11" fieldset-radius="4" fieldset-line-width="1" transparent="true">
         <view class="CTextLabel" origin="12, 24" size="196, 16" title="Width" font="label-font" font-color="text-dim" text-alignment="left" transparent="true"/>
         <view class="CParamDisplay" origin="208, 24" size="64, 16" control-tag="GranularStereoWidth" font="value-font" font-color="text" text-alignment="right" back-color="~ TransparentCColor" frame-color="~ TransparentCColor" style-no-frame="true"/>
         <view class="CSlider" origin="12, 46" size="260, 20" control-tag="GranularStereoWidth" orientation="horizontal" draw-frame="true" draw-back="true" draw-value="true" draw-frame-color="slider-frame" draw-back-color="slider-track" draw-value-color="accent" frame-width="1" transparent="true"/>
      </view>
   </template>
   <template name="SpectralPanel" class="CViewContainer" origin="0, 0" size="900, 480" background-color="panel" transparent="false">
      <view class="CViewContainer" origin="12, 12" size="284, 72" transparent="true" sub-controller="SpectralTimeSyncController">
         <view class="ArcKnob" origin="8, 8" size="56, 56" control-tag="SpectralBaseDelay" arc-color="accent" guide-color="slider-frame" arc-width="3"/>
         <view class="CTextLabel" origin="76, 10" size="120, 16" title="Time" font="label-font" font-color="text-dim" text-alignment="left" transparent="true"/>
         <view class="CParamDisplay" origin="76, 30" size="120, 24" control-tag="SpectralBaseDelay" font="readout-font" font-color="text" text-alignment="left" back-color="~ TransparentCColor" frame-color="~ TransparentCColor" style-no-frame="true"/>
         <view class="ToggleButton" origin="200, 32" size="76, 22" control-tag="SpectralTimeMode" title="Sync" title-position="right" icon-style="power" icon-size="0.6" font="label-font" on-color="accent" off-color="text-dim"/>
      </view>
      <view class="CViewContainer" origin="308, 12" size="284, 72" transparent="true">
         <view class="ArcKnob" origin="8, 8" size="56, 56" control-tag="SpectralFeedback" arc-color="accent" guide-color="slider-frame" arc-width="3"/>
         <view class="CTextLabel" origin="76, 10" size="120, 16" title="Feedback" font="label-font" font-color="text-dim" text-alignment="left" transparent="true"/>
         <view class="CParamDisplay" origin="76, 30" size="120, 24" control-tag="SpectralFeedback" font="readout-font" font-color="text" text-alignment="left" back-color="~ TransparentCColor" frame-color="~ TransparentCColor" style-no-frame="true"/>
      </view>
      <view class="CViewContainer" origin="604, 12" size="284, 72" transparent="true">
         <view class="ArcKnob" origin="8, 8" size="56, 56" control-tag="SpectralDryWet" arc-color="accent" guide-color="slider-frame" arc-width="3"/>
         <view class="CTextLabel" origin="76, 10" size="120, 16" title="Mix" font="label-font" font-color="text-dim" text-alignment="left" transparent="true"/>
         <view class="CParamDisplay" origin="76, 30" size="120, 24" control-tag="SpectralDryWet" font="readout-font" font-color="text" text-alignment="left" back-color="~ TransparentCColor" frame-color="~ TransparentCColor" style-no-frame="true"/>
         <view class="ToggleButton" origin="200, 32" size="76, 22" control-tag="SpectralFreeze" title="Freeze" title-position="right" icon-style="power" icon-size="0.6" font="label-font" on-color="accent" off-color="text-dim"/>
